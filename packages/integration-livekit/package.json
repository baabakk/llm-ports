{
  "name": "@llm-ports/integration-livekit",
  "version": "0.1.0-alpha.32",
  "description": "Route a LiveKit Agents voice agent through an @llm-ports LLMPort. LiveKit already abstracts providers; this adds what its LLM layer lacks: fallback chains, USD cost ceilings, per-provider budgets, and task routing. One constructor swap; the agent's tools, STT, TTS, and turn detection are untouched.",
  "license": "MIT",
  "author": "Babak Abbaschian",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@livekit/agents": ">=1.6 <2",
    "@llm-ports/core": "workspace:*"
  },
  "devDependencies": {
    "@livekit/agents": "^1.6.1",
    "@llm-ports/core": "workspace:*"
  },
  "keywords": [
    "llm-ports",
    "livekit",
    "voice-agents",
    "realtime",
    "llm-fallback",
    "cost-gating"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baabakk/llm-ports.git",
    "directory": "packages/integration-livekit"
  },
  "publishConfig": {
    "access": "public"
  }
}
